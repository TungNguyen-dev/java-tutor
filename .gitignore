*.log
logs/
tmp/
*.tmp
*.bak
*.swp
coverage/
node_modules/
.npm/
.node_repl_history


# ==============================================================================
# 6. MONOREPO SPECIFIC RULES (java-tutor)
# ==============================================================================
# Executable binaries and large tool files
tools/bin/

# Ignore only logs and temporary data inside storage
storage

# Other local data
.data/

